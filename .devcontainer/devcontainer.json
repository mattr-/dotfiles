{
  "name": "Ubuntu Focal (20.04)",
  "build": {
    "context": ".",
    "dockerfile": "./Dockerfile",
    "args": {
      "UBUNTU_VERSION": "focal"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "remoteUser": "vscode",
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
}
